{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M2.7",
  "plugins": [
    "opencode-wakatime"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push",
      "effect": "ask"
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "ask"
    }
  ],
